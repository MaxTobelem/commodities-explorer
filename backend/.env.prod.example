# Copy to backend/.env.prod on the server and fill in. NEVER commit .env.prod.

DEBUG=False
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME
# Your domain and/or Tailscale hostname/IP
ALLOWED_HOSTS=commodities.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://commodities.example.com

# --- Database (points at the `db` service) ---
POSTGRES_DB=commodities
POSTGRES_USER=commodities
POSTGRES_PASSWORD=CHANGE_ME_STRONG
DATABASE_URL=postgres://commodities:CHANGE_ME_STRONG@db:5432/commodities

# --- Localisation ---
LANGUAGE_CODE=fr-fr
TIME_ZONE=Europe/Paris

# --- TLS terminates upstream (Tailscale serve / TLS proxy) → no redirect loop ---
SECURE_SSL_REDIRECT=False

# --- Price data ---
COMMODITIES_API_KEY=

# --- Email (login codes) — Mailjet SMTP (gratuit 200/j). Vérifier un expéditeur d'abord. ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
EMAIL_HOST_USER=         # Mailjet : API Key
EMAIL_HOST_PASSWORD=     # Mailjet : Secret Key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ton-expediteur-verifie@exemple.com
