# Copy to .env and fill in. Real environment variables override these.

# --- Core ---
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# --- Database (SQLite by default; set for Postgres in prod) ---
# DATABASE_URL=postgres://user:password@localhost:5432/commodities

# --- Localisation ---
LANGUAGE_CODE=fr-fr
TIME_ZONE=UTC

# --- Price data provider (Commodities-API) — configured in M2 ---
COMMODITIES_API_KEY=
COMMODITIES_API_BASE_URL=https://api.commodities-api.com/api

# --- Email (passwordless login codes) — configured fully in M4 ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@your-domain.example
